+package pascal.taie.analysis.bugfinder;
+
+import pascal.taie.Main;
+import pascal.taie.World;
+import pascal.taie.language.classes.JClass;
+
+import javax.tools.ToolProvider;
+import java.io.ByteArrayOutputStream;
+import java.io.IOException;
+import java.nio.charset.StandardCharsets;
+import java.nio.file.Files;
+import java.nio.file.Path;
+import java.util.Set;
+
+import static org.junit.jupiter.api.Assertions.assertEquals;
+import static org.junit.jupiter.api.Assertions.assertNotNull;
+
+final class BytecodeBugFinderTests {
+
+    private BytecodeBugFinderTests() {
+    }
+
+    static JClass analyze(String fixture, String analysis, Path directory) throws IOException {
+        Path classes = Files.createDirectories(directory.resolve("classes"));
+        Path source = Path.of("src/test/resources/bugfinder", fixture + ".java");
+        var compiler = ToolProvider.getSystemJavaCompiler();
+        assertNotNull(compiler, "A JDK is required for bytecode regression tests");
+        ByteArrayOutputStream diagnostics = new ByteArrayOutputStream();
+        int exit = compiler.run(null, diagnostics, diagnostics, "-g", "-proc:none",
+                "-d", classes.toString(), source.toString());
+        assertEquals(0, exit, diagnostics.toString(StandardCharsets.UTF_8));
+        var args = new java.util.ArrayList<>(java.util.List.of("-acp", classes.toString(), "-a", analysis,
+                "--output-dir", directory.resolve("output").toString()));
+        if (analysis.equals(DivisionByZero.ID)) {
+            args.addAll(java.util.List.of("-a", "throw=exception:all", "-a", "cfg=exception:all"));
+        }
+        Main.main(args.toArray(String[]::new));
+        JClass result = World.get().getClassHierarchy().getClass(fixture);
+        assertNotNull(result);
+        return result;
+    }
+
+    static Set<BugInstance> findings(JClass clazz, String method, String analysis) {
+        return clazz.getDeclaredMethod(method).getIR().getResult(analysis);
+    }
+}
