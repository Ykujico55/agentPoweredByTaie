+++ b/src/test/resources/bugfinder/DivisionByZeroCases.java
@@ -0,0 +1,134 @@
+class DivisionByZeroCases {
+
+    static int divide(int numerator) {
+        int divisor = 0;
+        return numerator / divisor;
+    }
+
+    static int remainder(int numerator) {
+        int divisor = 0;
+        return numerator % divisor;
+    }
+
+    static long longDivide(long numerator) {
+        long divisor = 3L;
+        divisor -= 3L;
+        return numerator / divisor;
+    }
+
+    static long longRemainder(long numerator) {
+        long divisor = 0L;
+        return numerator % divisor;
+    }
+
+    static int unknown(int numerator, int divisor) {
+        return numerator / divisor;
+    }
+
+    static long unknownLong(long numerator, long divisor) {
+        return numerator / divisor;
+    }
+
+    static int nonzero(int numerator) {
+        int divisor = 2;
+        return numerator / divisor;
+    }
+
+    static long largeLong(long numerator) {
+        long divisor = 0x100000000L;
+        return numerator / divisor;
+    }
+
+    static double floating(double numerator) {
+        double divisor = 0.0;
+        return numerator / divisor;
+    }
+
+    static float floatingRemainder(float numerator) {
+        float divisor = 0.0f;
+        return numerator % divisor;
+    }
+
+    static int mixedBranch(boolean flag) {
+        int divisor;
+        if (flag) divisor = 0;
+        else divisor = 2;
+        return 5 / divisor;
+    }
+
+    static int zeroBranches(boolean flag) {
+        int divisor;
+        if (flag) divisor = 0;
+        else divisor = 0;
+        return 5 / divisor;
+    }
+
+    static long mixedLongBranch(boolean flag) {
+        long divisor;
+        if (flag) divisor = 0L;
+        else divisor = 2L;
+        return 5L / divisor;
+    }
+
+    static long zeroLongBranches(boolean flag) {
+        long divisor;
+        if (flag) divisor = 0L;
+        else divisor = 0L;
+        return 5L / divisor;
+    }
+
+    static int unreachable(int numerator) {
+        int flag = 1;
+        if (flag == 2) {
+            int divisor = 0;
+            return numerator / divisor;
+        }
+        return 0;
+    }
+
+    static int refined(int numerator, int divisor) {
+        if (divisor == 0) return numerator / divisor;
+        return 0;
+    }
+
+    static int unreachableLong(int numerator) {
+        long flag = 1L;
+        if (flag == 2L) {
+            int divisor = 0;
+            return numerator / divisor;
+        }
+        return 0;
+    }
+
+    static long liveLongCondition(long numerator) {
+        long flag = 1L;
+        if (flag == 1L) {
+            long divisor = 0L;
+            return numerator / divisor;
+        }
+        return 0;
+    }
+
+    static long promotedInt(long numerator) {
+        int divisor = 0;
+        return numerator / divisor;
+    }
+
+    static int caught(int numerator) {
+        int result;
+        try {
+            int divisor = 0;
+            result = numerator / divisor;
+        } catch (ArithmeticException failure) {
+            int divisor = 0;
+            return numerator % divisor;
+        }
+        return result;
+    }
+
+    static long loop(long numerator) {
+        long divisor = 1L;
+        for (int i = 0; i < 5; i++) divisor++;
+        return numerator / divisor;
+    }
+}
