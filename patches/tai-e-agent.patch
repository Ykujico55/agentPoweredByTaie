+class NullLiteralBytecode {
+
+    static int fails() {
+        String message = null;
+        return message.length();
+    }
+
+    static int guarded(String message) {
+        if (message == null) return 0;
+        return message.length();
+    }
+
+    static int clean() {
+        String message = "hello";
+        return message.length();
+    }
+
+    static int nullArray() {
+        int[] values = null;
+        return values[0];
+    }
+}
