+package pascal.taie.analysis.bugfinder;
+
+import pascal.taie.analysis.MethodAnalysis;
+import pascal.taie.analysis.dataflow.analysis.AbstractDataflowAnalysis;
+import pascal.taie.analysis.dataflow.analysis.constprop.CPFact;
+import pascal.taie.analysis.dataflow.analysis.constprop.ConstantPropagation;
+import pascal.taie.analysis.dataflow.analysis.constprop.Evaluator;
+import pascal.taie.analysis.dataflow.analysis.constprop.Value;
+import pascal.taie.analysis.dataflow.fact.MapFact;
+import pascal.taie.analysis.dataflow.fact.NodeResult;
+import pascal.taie.analysis.dataflow.solver.Solver;
+import pascal.taie.analysis.exception.ThrowAnalysis;
+import pascal.taie.analysis.exception.ThrowResult;
+import pascal.taie.analysis.graph.cfg.CFG;
+import pascal.taie.analysis.graph.cfg.CFGBuilder;
+import pascal.taie.analysis.graph.cfg.CFGEdge;
+import pascal.taie.config.AnalysisConfig;
+import pascal.taie.config.ConfigException;
+import pascal.taie.ir.IR;
+import pascal.taie.ir.exp.ArithmeticExp;
+import pascal.taie.ir.exp.CastExp;
+import pascal.taie.ir.exp.ComparisonExp;
+import pascal.taie.ir.exp.Exp;
+import pascal.taie.ir.exp.Exps;
+import pascal.taie.ir.exp.IntLiteral;
+import pascal.taie.ir.exp.LongLiteral;
+import pascal.taie.ir.exp.NegExp;
+import pascal.taie.ir.exp.Var;
+import pascal.taie.ir.stmt.DefinitionStmt;
+import pascal.taie.ir.stmt.If;
+import pascal.taie.ir.stmt.Stmt;
+import pascal.taie.ir.stmt.SwitchStmt;
+import pascal.taie.language.type.LongType;
+import pascal.taie.language.classes.ExceptionNames;
+import pascal.taie.util.collection.Sets;
+
+import java.util.ArrayDeque;
+import java.util.Collections;
+import java.util.Map;
+import java.util.Queue;
+import java.util.Set;
+
+/**
+ * Reports integral division/remainder whose divisor is definitely zero at the
+ * operation. Unknown divisors and floating-point operations are not reported.
+ * Integer facts come from constant propagation; a small companion analysis
+ * handles long values, which the existing int-only constant propagation omits.
+ * Requires throw and CFG options {@code exception:all} so that implicit
+ * ArithmeticException handlers are included in the control-flow graph.
+ */
+public class DivisionByZero extends MethodAnalysis<Set<BugInstance>> {
+
+    public static final String ID = "division-by-zero";
+
+    public DivisionByZero(AnalysisConfig config) {
+        super(config);
+    }
+
+    @Override
+    public Set<BugInstance> analyze(IR ir) {
+        CFG<Stmt> cfg = ir.getResult(CFGBuilder.ID);
+        requireImplicitExceptions(ir, cfg);
+        NodeResult<Stmt, CPFact> ints = ir.getResult(ConstantPropagation.ID);
+        NodeResult<Stmt, LongFact> longs = Solver.<Stmt, LongFact>getSolver()
+                .solve(new LongAnalysis(cfg, ints));
+        Set<BugInstance> findings = Sets.newOrderedSet();
+        Set<Stmt> visited = Sets.newSet();
+        Queue<Stmt> work = new ArrayDeque<>();
+        work.add(cfg.getEntry());
+        while (!work.isEmpty()) {
+            Stmt stmt = work.remove();
+            if (!visited.add(stmt)) {
+                continue;
+            }
+            boolean zero = hasZeroDivisor(stmt, ints, longs);
+            if (zero) {
+                ArithmeticExp arithmetic = (ArithmeticExp)
+                        ((DefinitionStmt<?, ?>) stmt).getRValue();
+                BugType type = arithmetic.getOperator() == ArithmeticExp.Op.DIV
+                        ? BugType.INTEGER_DIVIDE_BY_ZERO
+                        : BugType.INTEGER_REMAINDER_BY_ZERO;
+                findings.add(new BugInstance(type, Severity.CRITICAL, ir.getMethod())
+                        .setSourceLine(stmt.getLineNumber()));
+            }
+            for (CFGEdge<Stmt> edge : cfg.getOutEdgesOf(stmt)) {
+                if ((!zero || edge.isExceptional()) && isFeasible(edge, ints, longs)) {
+                    work.add(edge.target());
+                }
+            }
+        }
+        return findings;
+    }
+
+    private static void requireImplicitExceptions(IR ir, CFG<Stmt> cfg) {
+        ThrowResult exceptions = ir.getResult(ThrowAnalysis.ID);
+        for (Stmt stmt : ir) {
+            if (!(stmt instanceof DefinitionStmt<?, ?> definition)
+                    || !(definition.getRValue() instanceof ArithmeticExp arithmetic)
+                    || arithmetic.getOperator() != ArithmeticExp.Op.DIV
+                    && arithmetic.getOperator() != ArithmeticExp.Op.REM
+                    || !Exps.holdsInt(arithmetic.getOperand2())
+                    && !(arithmetic.getOperand2().getType() instanceof LongType)) {
+                continue;
+            }
+            boolean modeledThrow = exceptions != null && exceptions.mayThrowImplicitly(stmt).stream()
+                    .anyMatch(type -> type.getName().equals(ExceptionNames.ARITHMETIC_EXCEPTION));
+            boolean modeledEdge = cfg.getInEdgesOf(stmt).stream()
+                    .filter(edge -> !edge.isExceptional())
+                    .map(CFGEdge::source)
+                    .flatMap(predecessor -> cfg.getOutEdgesOf(predecessor).stream())
+                    .filter(CFGEdge::isExceptional)
+                    .flatMap(edge -> edge.getExceptions().stream())
+                    .anyMatch(type -> type.getName().equals(ExceptionNames.ARITHMETIC_EXCEPTION));
+            if (!modeledThrow || !modeledEdge) {
+                throw new ConfigException("division-by-zero requires implicit-exception modeling: "
+                        + "add -a throw=exception:all -a cfg=exception:all");
+            }
+        }
+    }
+
+    private static boolean hasZeroDivisor(Stmt stmt,
+                                         NodeResult<Stmt, CPFact> ints,
+                                         NodeResult<Stmt, LongFact> longs) {
+        if (!(stmt instanceof DefinitionStmt<?, ?> definition)
+                || !(definition.getRValue() instanceof ArithmeticExp arithmetic)
+                || arithmetic.getOperator() != ArithmeticExp.Op.DIV
+                && arithmetic.getOperator() != ArithmeticExp.Op.REM) {
+            return false;
+        }
+        Var divisor = arithmetic.getOperand2();
+        if (Exps.holdsInt(divisor)) {
+            Value value = ints.getInFact(stmt).get(divisor);
+            return value.isConstant() && value.getConstant() == 0;
+        } else if (divisor.getType() instanceof LongType) {
+            LongValue value = longs.getInFact(stmt).get(divisor);
+            return value.isConstant() && value.constant == 0L;
+        }
+        return false;
+    }
+
+    private static boolean isFeasible(CFGEdge<Stmt> edge,
+                                      NodeResult<Stmt, CPFact> ints,
+                                      NodeResult<Stmt, LongFact> longs) {
+        if (edge.source() instanceof If branch) {
+            Value condition = Evaluator.evaluate(branch.getCondition(), ints.getInFact(branch));
+            if (!condition.isConstant()) {
+                LongValue left = integralValue(branch.getCondition().getOperand1(),
+                        longs.getInFact(branch), ints.getInFact(branch));
+                LongValue right = integralValue(branch.getCondition().getOperand2(),
+                        longs.getInFact(branch), ints.getInFact(branch));
+                if (left.isConstant() && right.isConstant()) {
+                    boolean holds = switch (branch.getCondition().getOperator()) {
+                        case EQ -> left.constant.longValue() == right.constant.longValue();
+                        case NE -> left.constant.longValue() != right.constant.longValue();
+                        case LT -> left.constant < right.constant;
+                        case LE -> left.constant <= right.constant;
+                        case GT -> left.constant > right.constant;
+                        case GE -> left.constant >= right.constant;
+                    };
+                    condition = Value.makeConstant(holds ? 1 : 0);
+                }
+            }
+            if (condition.isConstant()) {
+                return !(condition.getConstant() == 0 && edge.getKind() == CFGEdge.Kind.IF_TRUE
+                        || condition.getConstant() != 0 && edge.getKind() == CFGEdge.Kind.IF_FALSE);
+            }
+        } else if (edge.source() instanceof SwitchStmt branch) {
+            Value value = ints.getInFact(branch).get(branch.getVar());
+            if (value.isConstant()) {
+                if (edge.isSwitchCase()) {
+                    return value.getConstant() == edge.getCaseValue();
+                } else if (edge.getKind() == CFGEdge.Kind.SWITCH_DEFAULT) {
+                    return !branch.getCaseValues().contains(value.getConstant());
+                }
+            }
+        }
+        return true;
+    }
+
+    private static LongValue integralValue(Var var, LongFact longs, CPFact ints) {
+        if (var.getType() instanceof LongType) {
+            return longs.get(var);
+        } else if (Exps.holdsInt(var)) {
+            Value value = ints.get(var);
+            if (value.isConstant()) {
+                return LongValue.of(value.getConstant());
+            }
+            // A long comparison yields an int, which int-only CP cannot evaluate.
+            LongValue comparison = longs.get(var);
+            if (comparison.isConstant()) {
+                return comparison;
+            }
+            return value.isUndef() && comparison.undefined ? LongValue.UNDEF : LongValue.NAC;
+        }
+        return LongValue.NAC;
+    }
+
+    private enum BugType implements pascal.taie.analysis.bugfinder.BugType {
+        INTEGER_DIVIDE_BY_ZERO,
+        INTEGER_REMAINDER_BY_ZERO
+    }
+
+    private record LongValue(boolean undefined, Long constant) {
+
+        private static final LongValue UNDEF = new LongValue(true, null);
+
+        private static final LongValue NAC = new LongValue(false, null);
+
+        private static LongValue of(long value) {
+            return new LongValue(false, value);
+        }
+
+        private boolean isConstant() {
+            return constant != null;
+        }
+
+        private static LongValue meet(LongValue a, LongValue b) {
+            if (a.undefined) {
+                return b;
+            } else if (b.undefined || a.equals(b)) {
+                return a;
+            }
+            return NAC;
+        }
+    }
+
+    private static class LongFact extends MapFact<Var, LongValue> {
+
+        private LongFact() {
+            this(Collections.emptyMap());
+        }
+
+        private LongFact(Map<Var, LongValue> map) {
+            super(map);
+        }
+
+        @Override
+        public LongValue get(Var var) {
+            if (var.isConst() && var.getConstValue() instanceof LongLiteral literal) {
+                return LongValue.of(literal.getValue());
+            }
+            return map.getOrDefault(var, LongValue.UNDEF);
+        }
+
+        @Override
+        public boolean update(Var var, LongValue value) {
+            if (var.isConst()) {
+                return false;
+            }
+            return value.undefined ? remove(var) != null : super.update(var, value);
+        }
+
+        @Override
+        public LongFact copy() {
+            return new LongFact(map);
+        }
+    }
+
+    private static class LongAnalysis extends AbstractDataflowAnalysis<Stmt, LongFact> {
+
+        private final NodeResult<Stmt, CPFact> ints;
+
+        private LongAnalysis(CFG<Stmt> cfg, NodeResult<Stmt, CPFact> ints) {
+            super(cfg);
+            this.ints = ints;
+        }
+
+        @Override
+        public boolean isForward() {
+            return true;
+        }
+
+        @Override
+        public LongFact newBoundaryFact() {
+            LongFact fact = newInitialFact();
+            cfg.getIR().getParams().stream()
+                    .filter(var -> var.getType() instanceof LongType)
+                    .forEach(var -> fact.update(var, LongValue.NAC));
+            return fact;
+        }
+
+        @Override
+        public LongFact newInitialFact() {
+            return new LongFact();
+        }
+
+        @Override
+        public void meetInto(LongFact fact, LongFact target) {
+            fact.forEach((var, value) -> target.update(var, LongValue.meet(value, target.get(var))));
+        }
+
+        @Override
+        public boolean transferNode(Stmt stmt, LongFact in, LongFact out) {
+            if (stmt instanceof DefinitionStmt<?, ?> definition
+                    && definition.getLValue() instanceof Var lhs
+                    && (lhs.getType() instanceof LongType
+                    || Exps.holdsInt(lhs))) {
+                boolean changed = false;
+                for (Var var : in.keySet()) {
+                    if (!var.equals(lhs)) {
+                        changed |= out.update(var, in.get(var));
+                    }
+                }
+                LongValue value = lhs.getType() instanceof LongType
+                        || definition.getRValue() instanceof ComparisonExp
+                        ? evaluate(definition.getRValue(), in, ints.getInFact(stmt)) : LongValue.NAC;
+                return out.update(lhs, value) || changed;
+            }
+            return out.copyFrom(in);
+        }
+
+        private LongValue evaluate(Exp exp, LongFact in, CPFact intFact) {
+            if (exp instanceof LongLiteral literal) {
+                return LongValue.of(literal.getValue());
+            } else if (exp instanceof IntLiteral literal) {
+                return LongValue.of(literal.getValue());
+            } else if (exp instanceof Var var) {
+                return integralValue(var, in, intFact);
+            } else if (exp instanceof CastExp cast && cast.getType() instanceof LongType) {
+                return evaluate(cast.getValue(), in, intFact);
+            } else if (exp instanceof NegExp negation) {
+                LongValue value = evaluate(negation.getOperand(), in, intFact);
+                return value.isConstant() ? LongValue.of(-value.constant) : value;
+            } else if (exp instanceof ComparisonExp comparison
+                    && comparison.getOperand1().getType() instanceof LongType) {
+                LongValue left = evaluate(comparison.getOperand1(), in, intFact);
+                LongValue right = evaluate(comparison.getOperand2(), in, intFact);
+                if (left.isConstant() && right.isConstant()) {
+                    return LongValue.of(Long.compare(left.constant, right.constant));
+                }
+                return left.equals(LongValue.NAC) || right.equals(LongValue.NAC)
+                        ? LongValue.NAC : LongValue.UNDEF;
+            } else if (exp instanceof ArithmeticExp arithmetic) {
+                LongValue a = evaluate(arithmetic.getOperand1(), in, intFact);
+                LongValue b = evaluate(arithmetic.getOperand2(), in, intFact);
+                if (a.isConstant() && b.isConstant()) {
+                    long left = a.constant;
+                    long right = b.constant;
+                    return switch (arithmetic.getOperator()) {
+                        case ADD -> LongValue.of(left + right);
+                        case SUB -> LongValue.of(left - right);
+                        case MUL -> LongValue.of(left * right);
+                        case DIV -> right == 0 ? LongValue.UNDEF : LongValue.of(left / right);
+                        case REM -> right == 0 ? LongValue.UNDEF : LongValue.of(left % right);
+                    };
+                }
+                return a.equals(LongValue.NAC) || b.equals(LongValue.NAC)
+                        ? LongValue.NAC : LongValue.UNDEF;
+            }
+            return LongValue.NAC;
+        }
+    }
+}
