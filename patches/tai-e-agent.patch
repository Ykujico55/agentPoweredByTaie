+package pascal.taie.analysis.bugfinder;
+
+import org.junit.jupiter.api.Test;
+import org.junit.jupiter.api.io.TempDir;
+import pascal.taie.Main;
+import pascal.taie.config.LoggerConfigs;
+
+import java.io.IOException;
+import java.nio.file.Path;
+import java.util.List;
+
+import static org.junit.jupiter.api.Assertions.assertEquals;
+import static org.junit.jupiter.api.Assertions.assertTrue;
+import static org.junit.jupiter.api.Assertions.assertThrows;
+import static pascal.taie.analysis.bugfinder.BytecodeBugFinderTests.findings;
+
+class DivisionByZeroTest {
+
+    @Test
+    void definiteIntegralZerosOnly(@TempDir Path directory) throws IOException {
+        var clazz = BytecodeBugFinderTests.analyze("DivisionByZeroCases", DivisionByZero.ID, directory);
+        for (String method : List.of("divide", "longDivide", "zeroBranches", "zeroLongBranches",
+                "refined", "promotedInt", "liveLongCondition")) {
+            var findings = findings(clazz, method, DivisionByZero.ID);
+            assertEquals(1, findings.size(), method);
+            BugInstance bug = findings.iterator().next();
+            assertEquals("INTEGER_DIVIDE_BY_ZERO", bug.getType().toString(), method);
+            assertTrue(bug.getSourceLineStart() > 0, method);
+        }
+        for (String method : List.of("remainder", "longRemainder")) {
+            var findings = findings(clazz, method, DivisionByZero.ID);
+            assertEquals(1, findings.size(), method);
+            assertEquals("INTEGER_REMAINDER_BY_ZERO", findings.iterator().next().getType().toString());
+        }
+        for (String method : List.of("unknown", "unknownLong", "nonzero", "largeLong", "floating",
+                "floatingRemainder", "mixedBranch", "mixedLongBranch", "unreachable", "unreachableLong", "loop")) {
+            assertTrue(findings(clazz, method, DivisionByZero.ID).isEmpty(), method);
+        }
+        var caught = findings(clazz, "caught", DivisionByZero.ID);
+        assertEquals(2, caught.size(), "both the try and its arithmetic-exception handler execute");
+        assertEquals(List.of("INTEGER_DIVIDE_BY_ZERO", "INTEGER_REMAINDER_BY_ZERO"),
+                caught.stream().map(bug -> bug.getType().toString()).sorted().toList());
+        try {
+            var missingModel = assertThrows(RuntimeException.class, () -> Main.main(new String[]{
+                    "-acp", directory.resolve("classes").toString(), "-a", DivisionByZero.ID,
+                    "--output-dir", directory.resolve("missing-model").toString()}));
+            assertTrue(missingModel.toString().contains("implicit-exception modeling"));
+        } finally {
+            // Main only resets logging after a successful run; release the file
+            // handle after the expected failure so Windows can delete @TempDir.
+            LoggerConfigs.reconfigure();
+        }
+    }
+}
