+package pascal.taie.analysis.bugfinder;
+
+import org.junit.jupiter.api.Test;
+import org.junit.jupiter.api.io.TempDir;
+import pascal.taie.analysis.bugfinder.nullpointer.NullPointerDetection;
+
+import java.io.IOException;
+import java.nio.file.Path;
+import java.util.List;
+
+import static org.junit.jupiter.api.Assertions.assertEquals;
+import static org.junit.jupiter.api.Assertions.assertTrue;
+import static pascal.taie.analysis.bugfinder.BytecodeBugFinderTests.findings;
+
+class NullLiteralBytecodeTest {
+
+    @Test
+    void nullLiteralDereferencesReportInsteadOfCrashing(@TempDir Path directory) throws IOException {
+        var clazz = BytecodeBugFinderTests.analyze("NullLiteralBytecode", NullPointerDetection.ID, directory);
+        for (String method : List.of("fails", "nullArray")) {
+            var findings = findings(clazz, method, NullPointerDetection.ID);
+            assertEquals(1, findings.size(), method);
+            BugInstance bug = findings.iterator().next();
+            assertEquals("NP_ALWAYS_NULL", bug.getType().toString(), method);
+            assertTrue(bug.getSourceLineStart() > 0, method);
+        }
+        for (String method : List.of("guarded", "clean")) {
+            assertTrue(findings(clazz, method, NullPointerDetection.ID).isEmpty(), method);
+        }
+    }
+}
