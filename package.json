{
  "name": "taie-coding-agent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A Pi-based Java coding agent with real Tai-e analysis and automatic verification.",
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "start": "node src/cli.ts",
    "analyze": "node src/cli.ts analyze",
    "doctor": "node src/cli.ts doctor",
    "build:maven-image": "docker build -f containers/maven/Dockerfile -t taie-agent-maven:0.1 .",
    "check:maven": "node src/cli.ts check-maven",
    "test:maven": "node scripts/smoke-maven.ts",
    "setup:taie": "node scripts/setup-taie.mjs",
    "setup:taie-source": "node scripts/setup-taie-source.mjs",
    "build:taie-source": "node scripts/build-taie-source.mjs",
    "export:taie-patches": "node scripts/export-taie-patches.mjs",
    "test:taie-patches": "node scripts/verify-taie-patches.mjs",
    "start:extended": "node scripts/with-source-taie.mjs",
    "analyze:extended": "node scripts/with-source-taie.mjs analyze",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.ts",
    "test:host": "node --test tests/config.test.ts tests/turn.test.ts tests/verification.test.ts tests/chat-settings.test.ts tests/console-input.test.ts tests/repair-guard.test.ts tests/cli-ui.test.ts tests/reporting.test.ts tests/process.test.ts tests/maven.test.ts tests/docker-maven.test.ts tests/finding-origin.test.ts tests/maven-storage.test.ts tests/check.test.ts tests/check-markdown.test.ts tests/agent-check.test.ts",
    "test:live": "node scripts/smoke-live.ts",
    "test:live:extended": "node scripts/smoke-live-extended.ts",
    "test:live:policy": "node scripts/smoke-live-policy.ts",
    "test:live:maven": "node scripts/smoke-live-maven.ts",
    "test:taie-source": "node scripts/smoke-taie-source.ts"
  },
  "dependencies": {
    "@earendil-works/pi-coding-agent": "0.85.1",
    "fast-xml-parser": "5.7.3",
    "typebox": "1.3.7"
  },
  "devDependencies": {
    "@types/node": "22.19.19",
    "typescript": "5.9.3"
  }
}
